{
	"compilerOptions": {
		"target": "ES2021",
		"lib": ["ES2021", "DOM"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["cypress", "node"],
		"esModuleInterop": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"isolatedModules": true
	},
	"include": ["**/*.ts"]
}
