# Maximum seconds to wait between stream chunks before aborting (default: 60, minimum recommended: 30)
AIOHTTP_CLIENT_TIMEOUT_SOCK_READ=60

LANGFUSE_SK=""
LANGFUSE_PK=""
LANGFUSE_HOST=""

BILLING_ENABLED=true
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=price_item        # legacy alias — treated as pro price ID if STRIPE_PRICE_ID_PRO is unset
STRIPE_PRICE_ID_PRO=               # Stripe price ID for the Pro plan (overrides STRIPE_PRICE_ID)
STRIPE_PRICE_ID_PREMIUM=           # Stripe price ID for the Premium plan
STRIPE_FREE_TIER_CENTS=500
WEBUI_URL=http://localhost:5173

# Chat encryption
# Set CHAT_ENCRYPTION_ENABLED=true to encrypt chat message bodies at rest.
# BACKEND_ENCRYPTION=local       — uses CHAT_ENCRYPTION_KEY (dev / SQLite)
# BACKEND_ENCRYPTION=gcp_kms     — reads key from GCP Secret Manager at startup (production)
CHAT_ENCRYPTION_ENABLED=false
BACKEND_ENCRYPTION=local
# Required when BACKEND_ENCRYPTION=local — base64-encoded 32-byte AES-256 key
# Generate with: python3 -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
CHAT_ENCRYPTION_KEY=""
# Required when BACKEND_ENCRYPTION=gcp_kms
# e.g. projects/my-project/secrets/chat-encryption-key/versions/latest
KMS_SECRET_NAME=""

# OAuth — Google
# GOOGLE_REDIRECT_URI=https://your-domain.com/oauth/google/callback

# OAuth — Microsoft
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_CLIENT_TENANT_ID=
# MICROSOFT_OAUTH_SCOPE=openid email profile User.Read
# MICROSOFT_REDIRECT_URI=https://your-domain.com/oauth/microsoft/callback
TRIAL_CREDIT_EUR=2.0

# JSON map: seat count → {price_id, price_eur, usage_budget_eur}
STRIPE_TEAM_TIERS={"5": {"price_id": "price_xxx", "price_eur": 249, "usage_budget_eur": 250}}

# JSON list of one-time top-up options
STRIPE_TOPUP_AMOUNTS=[{"price_id": "price_topup50", "amount_eur": 50}, {"price_id": "price_topup100", "amount_eur": 100}]

# SMTP for invite emails (optional — invites are skipped if not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME=Hubgate-dev
# Gates STARTTLS on the SMTP connection. Set to false for local dev (e.g. Mailpit)
SMTP_USE_TLS=false

WEBUI_URL=http://localhost:5173

# Trustminder feedback button control, if not supplied, it will default to false
ENABLE_TRUSTMINDER_FEEDBACK=false


# How many days of Langfuse history to import on first deploy when usage_ledger is empty. Ignored after first sync — DB watermark takes over.
LEDGER_BOOTSTRAP_DAYS=30

# Credits conversion rate: how many credits equal 1 euro cent of Langfuse cost.
# REQUIRED when BILLING_ENABLED=true — missing value crashes on startup.
# Locked into each user's row at plan assignment; changing this only affects new signups and renewals.
CREDITS_PER_EUR_CENT=1.82

# Comma-separated list of email domains considered internal (e.g. "keepersolutions.com")
INTERNAL_EMAIL_DOMAINS=

# Comma-separated list of specific emails that should have unlimited credits
# (in addition to internal domains). Example: "user126@gmail.com,another@example.com"
UNLIMITED_USER_EMAILS=

#Interval for syncing cost; 300 seconds is a fallback if the value is not provided
LEDGER_POLL_INTERVAL=30